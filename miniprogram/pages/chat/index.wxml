<view class="page">
  <business-switcher current="activation" title="激活码服务" />

  <scroll-view
    class="messages-container"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-with-animation="{{animateScroll}}"
    scroll-into-view="{{scrollIntoView}}"
    enable-back-to-top
  >
    <view class="messages-list">
      <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="message-row {{item.role}}">
        <view class="message-stack {{item.role}}">
          <view class="message-bubble {{item.role}}">
            <text class="message-text">{{item.content}}</text>
          </view>
          <text class="message-time">{{item.timeText}}</text>
        </view>
      </view>

      <view wx:if="{{loading}}" class="message-row bot" id="typing-indicator">
        <view class="message-stack bot">
          <view class="message-bubble bot typing-bubble">
            <view class="typing-dot"></view>
            <view class="typing-dot"></view>
            <view class="typing-dot"></view>
          </view>
        </view>
      </view>
      <view class="bottom-anchor"></view>
    </view>
  </scroll-view>

  <view class="composer-wrap">
    <view class="composer">
      <input
        class="composer-input"
        value="{{text}}"
        focus="{{inputFocus}}"
        placeholder="输入指令或消息…"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="onSend"
        bindfocus="onInputFocus"
        bindblur="onInputBlur"
        adjust-position
      />
      <button class="send-btn {{text ? 'active' : ''}}" bindtap="onSend" disabled="{{loading || !text}}">
        <text>{{loading ? '···' : '发送'}}</text>
      </button>
    </view>
  </view>
</view>
