<view class="page">
  <business-switcher current="yuuki" title="Yuuki 号池" />

  <scroll-view class="content" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="section-card primary-section">
      <view class="section-head">
        <view>
          <text class="section-title">创建账号</text>
          <text class="section-desc">常用 1 - 2 个，也可一次创建 3 个</text>
        </view>
      </view>

      <view class="create-row">
        <view class="count-switch">
          <button wx:for="{{registerCounts}}" wx:key="*this" class="count-btn {{registerCount === item ? 'active' : ''}}" data-count="{{item}}" bindtap="setRegisterCount">{{item}}</button>
        </view>
        <button class="main-btn create-btn" bindtap="registerAccounts" loading="{{actionLoading === 'register'}}" disabled="{{actionLoading}}">创建</button>
      </view>

      <view wx:if="{{createdAccounts.length}}" class="created-box">
        <text class="result-label">刚刚创建</text>
        <view wx:for="{{createdAccounts}}" wx:key="username" class="created-row">
          <view class="created-account">
            <text class="mono strong">{{item.username}}</text>
            <text class="mono muted">{{item.password}}</text>
          </view>
          <view class="created-actions">
            <button class="text-btn" data-username="{{item.username}}" data-password="{{item.password}}" bindtap="copyAccount">复制</button>
            <button class="text-btn accent" data-username="{{item.username}}" data-typ="all" bindtap="allowLogin">允许登录</button>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head inline-head">
        <view>
          <text class="section-title">允许登录</text>
          <text class="section-desc">输入账号后直接操作，有效约 5 分钟</text>
        </view>
      </view>

      <view class="input-shell">
        <input
          value="{{quickLoginUsername}}"
          bindinput="onQuickLoginInput"
          type="number"
          maxlength="32"
          placeholder="输入账号"
          confirm-type="done"
        />
      </view>
      <view class="login-actions">
        <button class="main-btn login-main" data-typ="all" bindtap="quickAllowLogin" loading="{{actionLoading !== ''}}" disabled="{{actionLoading}}">允许登录</button>
        <button class="secondary-btn" data-typ="ip_add" bindtap="quickAllowLogin" disabled="{{actionLoading}}">服务器 IP</button>
      </view>
    </view>

    <view class="section-card search-section">
      <view class="section-head">
        <view>
          <text class="section-title">搜索账号</text>
          <text class="section-desc">查到后可复制、登录、回池或废弃</text>
        </view>
      </view>
      <view class="search-row">
        <view class="input-shell search-input">
          <text class="search-mark">⌕</text>
          <input value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="onSearch" confirm-type="search" placeholder="账号或备注" />
          <text wx:if="{{keyword}}" class="clear" bindtap="clearSearch">×</text>
        </view>
        <button class="search-btn" bindtap="onSearch" loading="{{loading}}">搜索</button>
      </view>
    </view>

    <view class="more-card">
      <view class="more-toggle" bindtap="toggleAdvanced">
        <view>
          <text class="more-title">更多工具</text>
          <text class="more-subtitle">库存、取号与状态浏览</text>
        </view>
        <text class="chevron {{showAdvanced ? 'open' : ''}}">⌄</text>
      </view>

      <view wx:if="{{showAdvanced}}" class="advanced-body">
        <view class="stats-row">
          <view class="stat"><text class="stat-n">{{stats.total}}</text><text class="stat-l">总数</text></view>
          <view class="stat"><text class="stat-n available">{{stats.available}}</text><text class="stat-l">可用</text></view>
          <view class="stat"><text class="stat-n issued">{{stats.issued}}</text><text class="stat-l">已发出</text></view>
          <view class="stat"><text class="stat-n discarded">{{stats.discarded}}</text><text class="stat-l">已废弃</text></view>
        </view>

        <button class="take-btn" bindtap="takeNext" loading="{{actionLoading === 'next'}}" disabled="{{actionLoading}}">取一个可用账号并复制</button>

        <view class="browse-block">
          <text class="browse-title">按状态浏览</text>
          <scroll-view class="filter-scroll" scroll-x show-scrollbar="{{false}}">
            <view class="filter-row">
              <button wx:for="{{statusOptions}}" wx:key="value" class="filter-chip {{status === item.value && listActivated && !keyword ? 'active' : ''}}" data-status="{{item.value}}" bindtap="changeStatus">{{item.label}}</button>
            </view>
          </scroll-view>
        </view>

        <view wx:if="{{lastIssued}}" class="last-issued">
          <text class="last-label">最近取号</text>
          <text class="mono strong">{{lastIssued.username}}</text>
          <button class="text-btn" data-username="{{lastIssued.username}}" data-password="{{lastIssued.password}}" bindtap="copyAccount">复制</button>
        </view>
      </view>
    </view>

    <view wx:if="{{listActivated}}" class="results-card">
      <view class="results-head">
        <text class="results-title">{{listTitle}}</text>
        <text class="results-count">{{total}} 条</text>
      </view>

      <view wx:if="{{!loading && !items.length}}" class="empty-state">
        <text class="empty-title">没有找到账号</text>
        <text class="empty-desc">检查账号或搜索条件后再试。</text>
      </view>

      <view wx:for="{{items}}" wx:key="id" class="account-row">
        <view class="account-head">
          <view class="account-id">
            <text class="mono strong username">{{item.username}}</text>
            <text class="mono muted password">{{item.password}}</text>
          </view>
          <text class="status status-{{item.status}}">{{item.status === 'available' ? '可用' : item.status === 'issued' ? '已发出' : '已废弃'}}</text>
        </view>

        <text wx:if="{{item.remark}}" class="remark">{{item.remark}}</text>

        <view class="account-actions">
          <button class="mini-btn" data-username="{{item.username}}" data-password="{{item.password}}" bindtap="copyAccount">复制</button>
          <block wx:if="{{item.status !== 'discarded'}}">
            <button class="mini-btn primary" data-username="{{item.username}}" data-typ="all" bindtap="allowLogin">允许登录</button>
            <button class="mini-btn subtle" data-username="{{item.username}}" data-typ="ip_add" bindtap="allowLogin">服务器 IP</button>
            <button wx:if="{{item.status === 'issued'}}" class="mini-btn subtle" data-username="{{item.username}}" bindtap="releaseAccount">回池</button>
            <button class="mini-btn danger" data-username="{{item.username}}" bindtap="discardAccount">废弃</button>
          </block>
          <text wx:else class="discard-note">已废弃，仅保留标记</text>
        </view>
      </view>

      <button wx:if="{{hasMore}}" class="load-more" bindtap="loadMore" loading="{{loading}}">加载更多</button>
    </view>

    <view class="safe-space"></view>
  </scroll-view>
</view>
